// Standard version
cc_binary {
    name: "dhrystone",
    srcs: [
        "dry1.c",
        "dry2.c",
    ],
    local_include_dirs: ["."],
    cflags: [
        "-O3",
        "-Wall",
        "-Werror",
        "-Wno-knr-promoted-parameter",
		"-Wno-deprecated-non-prototype",
    ],
    vendor: true,
}

// Version with register optimization
cc_binary {
    name: "dhrystone_reg",
    srcs: [
        "dry1.c",
        "dry2.c",
    ],
    local_include_dirs: ["."],
    cflags: [
        "-O3",
        "-Wall",
        "-Werror",
        "-Wno-knr-promoted-parameter",
		"-Wno-deprecated-non-prototype",
        "-DREG",
    ],
    vendor: true,
}

// Version with compiler optimization
cc_binary {
    name: "dhrystone_opt",
    srcs: [
        "dry1.c",
        "dry2.c",
    ],
    local_include_dirs: ["."],
    cflags: [
        "-O3",
        "-Wall",
        "-Werror",
        "-Wno-knr-promoted-parameter",
		"-Wno-deprecated-non-prototype",
        "-O",
    ],
    vendor: true,
}